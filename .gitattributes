# Normalize line endings; Go tooling and CI expect LF
* text=auto
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# The file server tests compare served bytes, so test files must stay LF on Windows checkouts
# with core.autocrlf=true.
file/testdata/** text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
